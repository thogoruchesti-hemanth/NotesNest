<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/floatingNavContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Bottom Navigation Bar Container -->
    <FrameLayout
        android:id="@+id/floatingNavContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_nav_with_border"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp">

            <!-- Slot 1: Notes -->
            <LinearLayout
                android:id="@+id/navItemNotes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/navIconNotes"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/text_notes"
                    android:src="@drawable/ic_notes"
                    app:tint="@color/tabSelectedTextColor" />

                <TextView
                    android:id="@+id/navTextNotes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/text_notes"
                    android:textColor="@color/tabSelectedTextColor"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Slot 2: Reminders -->
            <LinearLayout
                android:id="@+id/navItemReminders"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/navIconReminders"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/text_reminders"
                    android:src="@drawable/ic_reminders"
                    app:tint="@color/grey_400" />

                <TextView
                    android:id="@+id/navTextReminders"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/text_reminders"
                    android:textColor="@color/grey_400"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Slot 3: Center Cradle Space -->
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2" />

            <!-- Slot 4: Settings -->
            <LinearLayout
                android:id="@+id/navItemSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/navIconSettings"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/text_settings"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/grey_400" />

                <TextView
                    android:id="@+id/navTextSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/text_settings"
                    android:textColor="@color/grey_400"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Slot 5: Profile -->
            <LinearLayout
                android:id="@+id/navItemProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/navIconProfile"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/text_profile"
                    android:src="@drawable/ic_profile"
                    app:tint="@color/grey_400" />

                <TextView
                    android:id="@+id/navTextProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/text_profile"
                    android:textColor="@color/grey_400"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

    <!-- Floating Yellow Circular FAB -->
    <ImageButton
        android:id="@+id/fabCreate"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_circle_yellow_solid"
        android:contentDescription="@string/text_create"
        android:elevation="12dp"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_add_black"
        app:layout_constraintBottom_toTopOf="@+id/floatingNavContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/floatingNavContainer"
        app:tint="@color/black" />

</androidx.constraintlayout.widget.ConstraintLayout>
