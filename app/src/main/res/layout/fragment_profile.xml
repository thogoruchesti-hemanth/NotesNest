<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/padding_16"
        android:paddingTop="@dimen/padding_20"
        android:paddingBottom="@dimen/padding_40">

        <!-- Profile Header Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/radius_16"
            app:cardElevation="@dimen/elevation_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/padding_20">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <View
                        android:id="@+id/premiumRing"
                        android:layout_width="104dp"
                        android:layout_height="104dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_premium_ring"
                        android:visibility="gone" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivProfileImage"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_profile"
                        app:shapeAppearanceOverlay="@style/RoundedImageStyle" />

                    <ImageView
                        android:id="@+id/ivPremiumBadge"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="bottom|end"
                        android:contentDescription="@string/text_premium_access"
                        android:src="@drawable/ic_pro_yellow"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_12"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/text_user_name"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_20"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUserEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_4"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/text_email"
                    android:textColor="@color/grey_400"
                    android:textSize="@dimen/text_14" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_16"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnEditProfile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/grey_900"
                        android:text="@string/text_profile_image"
                        android:textColor="@color/white"
                        app:cornerRadius="@dimen/radius_20" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnGetPro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_12"
                        android:background="@drawable/bg_rounded_yellow_gradient"
                        android:paddingHorizontal="@dimen/padding_16"
                        android:text="@string/text_premium_access"
                        android:textColor="@color/black"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Options Section Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_24"
            android:text="@string/text_resources"
            android:textColor="@color/grey_400"
            android:textSize="@dimen/text_14"
            android:textStyle="bold" />

        <!-- Options Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_8"
            app:cardCornerRadius="@dimen/radius_16"
            app:cardElevation="@dimen/elevation_2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Settings Item -->
                <LinearLayout
                    android:id="@+id/layoutSettings"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_60"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/padding_16">

                    <ImageView
                        android:layout_width="@dimen/size_24"
                        android:layout_height="@dimen/size_24"
                        android:contentDescription="@string/text_settings"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/black" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_16"
                        android:layout_weight="1"
                        android:text="@string/text_settings"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_16"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="@dimen/size_24"
                        android:layout_height="@dimen/size_24"
                        android:contentDescription="@string/text_chevron_down_arrow"
                        android:src="@drawable/ic_chevron_right_black" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/grey_200" />

                <!-- Drive Backup Item -->
                <LinearLayout
                    android:id="@+id/layoutDriveBackup"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_60"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/padding_16">

                    <ImageView
                        android:layout_width="@dimen/size_24"
                        android:layout_height="@dimen/size_24"
                        android:contentDescription="@string/text_caps_backup_sync"
                        android:src="@drawable/ic_drive_backup"
                        app:tint="@color/black" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_16"
                        android:layout_weight="1"
                        android:text="@string/text_caps_backup_sync"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_16"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="@dimen/size_24"
                        android:layout_height="@dimen/size_24"
                        android:contentDescription="@string/text_chevron_down_arrow"
                        android:src="@drawable/ic_chevron_right_black" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/grey_200" />

                <!-- Help & Support Item -->
                <LinearLayout
                    android:id="@+id/layoutHelpAndSupport"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_60"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/padding_16">

                    <ImageView
                        android:layout_width="@dimen/size_24"
                        android:layout_height="@dimen/size_24"
                        android:contentDescription="@string/text_help_support"
                        android:src="@drawable/ic_help_and_support"
                        app:tint="@color/black" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_16"
                        android:layout_weight="1"
                        android:text="@string/text_help_support"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_16"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="@dimen/size_24"
                        android:layout_height="@dimen/size_24"
                        android:contentDescription="@string/text_chevron_down_arrow"
                        android:src="@drawable/ic_chevron_right_black" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
